{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ../../pnpm-lock.yaml",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "getinboxlink.vercel.app"
        }
      ],
      "destination": "https://inboxlink.cieltd.org/:path*",
      "permanent": false
    }
  ]
}
