{
  "name": "@inboxlink/core",
  "version": "0.1.0",
  "description": "InboxLink types, normalized models, adapter interfaces, and crypto helpers",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "tsc -b tsconfig.json",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EtienneFokou-E18560/inboxlink.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/EtienneFokou-E18560/inboxlink/issues"
  },
  "homepage": "https://github.com/EtienneFokou-E18560/inboxlink/tree/main/packages/core#readme",
  "keywords": [
    "inboxlink",
    "email",
    "oauth",
    "types"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  }
}
