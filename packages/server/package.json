{
  "name": "@inboxlink/server",
  "version": "0.0.1",
  "description": "InboxLink HTTP API + workers (Hono)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "inboxlink-server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "tsc -b tsconfig.json",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test src/grants.integration.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@inboxlink/adapters-gmail": "workspace:*",
    "@inboxlink/core": "workspace:*",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.7.5"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  },
  "optionalDependencies": {
    "bullmq": "^5.44.0",
    "ioredis": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
