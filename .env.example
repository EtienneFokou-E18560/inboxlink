# InboxLink local development — placeholders only. Never commit real secrets.

# Runtime mode: single | multi
INBOXLINK_MODE=single

# HTTP
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
HOST=0.0.0.0

# Postgres. Required on Vercel so link sessions, grants, and vault ciphertext
# survive across serverless instances. Leave unset for the in-memory store.
# Any Postgres works (local Compose, Neon, Vercel Postgres). Never commit a real URL.
DATABASE_URL=postgres://inboxlink:inboxlink@localhost:5432/inboxlink

# Envelope encryption master key (32+ byte secret; generate locally)
# Example only — replace before any real OAuth:
INBOXLINK_MASTER_KEY=replace-with-32-byte-or-longer-random-secret

# Tenant API secret (Bearer token for host apps in multi mode)
INBOXLINK_API_SECRET=dev-api-secret-change-me

# Google OAuth (Gmail) — register a Cloud project; testing mode only for v0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8787/v1/oauth/gmail/callback

# Default Gmail scopes (readonly). Do not use mail.google.com unless IMAP is required.
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly openid email

# Optional Redis / BullMQ (sync workers). Leave unset to skip queue stubs.
REDIS_URL=redis://localhost:6379

# Optional webhook signing secret for host callbacks
INBOXLINK_WEBHOOK_SECRET=dev-webhook-secret-change-me
