# InboxLink local development — placeholders only. Never commit real secrets.

# Runtime mode: single | multi
# Local default is single (no Bearer). Production runs multi and requires
# INBOXLINK_API_SECRET; host apps must send Authorization: Bearer.
INBOXLINK_MODE=single

# HTTP
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
HOST=0.0.0.0

# Postgres. Required on Vercel so link sessions, grants, and vault ciphertext
# survive across serverless instances. Leave unset for the in-memory store.
# Any Postgres works (local Compose, Neon, Vercel Postgres). Never commit a real URL.
DATABASE_URL=postgres://inboxlink:inboxlink@localhost:5432/inboxlink

# Envelope encryption master key (32+ byte secret; generate locally)
# Example only — replace before any real OAuth:
INBOXLINK_MASTER_KEY=replace-with-32-byte-or-longer-random-secret

# Tenant API secret (Bearer token for host apps in multi mode).
# Rotate by deploying a new value and updating host clients; never commit real secrets.
INBOXLINK_API_SECRET=dev-api-secret-change-me

# Tenant id for INBOXLINK_API_SECRET (multi mode). Default: default
# INBOXLINK_TENANT_ID=default

# Optional additional tenants: tenantId=secret pairs (comma or newline separated)
# INBOXLINK_TENANT_SECRETS=acme=replace-me,other=replace-me

# Soft in-process rate limits for Connect + host APIs (single and multi).
# Window ms / max requests per client key (IP in single; tenant in multi).
# INBOXLINK_RATE_LIMIT_WINDOW_MS=60000
# INBOXLINK_RATE_LIMIT_MAX=120

# Optional host Connect redirectUri origin allowlist (scheme+host+port).
# Unset / empty = permissive redirects (any http(s) URL) — fine for single-tenant demo.
# When set, POST /v1/link/sessions rejects redirectUri whose origin is not listed.
# Browser CORS always mirrors this list plus PUBLIC_BASE_URL origin (never *).
# Example: ALLOWED_REDIRECT_ORIGINS=https://app.example.com,http://127.0.0.1:9999
# ALLOWED_REDIRECT_ORIGINS=

# Google OAuth (Gmail) — register a Cloud project; testing mode only for v0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8787/v1/oauth/gmail/callback

# Default Gmail scopes (readonly). Do not use mail.google.com unless IMAP is required.
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly openid email

# Optional Redis / BullMQ (sync workers). Leave unset to skip queue stubs.
REDIS_URL=redis://localhost:6379

# Host webhooks (Wave C). Delivery is off unless BOTH are set.
# InboxLink POSTs signed JSON events to INBOXLINK_WEBHOOK_URL.
# Signature header: X-InboxLink-Signature: sha256=<hex> (HMAC-SHA256 over raw body).
# Verify with InboxLink.webhooks.verify({ payload, signatureHeader, secret }).
# Events: grant.connected, grant.needs_reauth, sync.completed
# (message.created deferred — Wave D / Gmail push.)
# INBOXLINK_WEBHOOK_URL=https://your-app.example.com/inboxlink/webhooks
INBOXLINK_WEBHOOK_SECRET=dev-webhook-secret-change-me
