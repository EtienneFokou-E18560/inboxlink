{
  "name": "inboxlink",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source mailbox connection infrastructure — Plaid for email",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.vercel.json --noEmit",
    "lint": "pnpm -r run lint && tsc -p tsconfig.vercel.json --noEmit",
    "dev:server": "pnpm --filter @inboxlink/server dev",
    "test": "pnpm -r --if-present run test",
    "check:docs": "node scripts/check-release-docs.mjs",
    "smoke:health": "bash scripts/smoke-health.sh",
    "clean": "pnpm -r exec rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@inboxlink/server": "workspace:*",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
