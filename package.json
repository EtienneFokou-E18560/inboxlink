{
  "name": "inboxlink",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source mailbox connection infrastructure — Plaid for email",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.vercel.json --noEmit",
    "lint": "pnpm -r run lint && tsc -p tsconfig.vercel.json --noEmit",
    "dev:server": "pnpm --filter @inboxlink/server dev",
    "clean": "pnpm -r exec rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@inboxlink/server": "workspace:*",
    "hono": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
