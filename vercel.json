{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/v1/internal/cron/drain-sync-jobs",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/v1/internal/cron/renew-gmail-watches",
      "schedule": "0 6 * * *"
    }
  ]
}
