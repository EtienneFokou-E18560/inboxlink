# Host app environment (not InboxLink server).
# Do NOT set GOOGLE_*, DATABASE_URL, or INBOXLINK_MASTER_KEY here —
# those stay on the InboxLink service (Production or your self-host).

# Optional. SDK defaults to Production when unset:
#   https://inboxlink-two.vercel.app
# INBOXLINK_BASE_URL=https://inboxlink-two.vercel.app

# Local InboxLink server instead of Production:
# INBOXLINK_BASE_URL=http://localhost:8787

# Required for Production (INBOXLINK_MODE=multi) and any multi server.
# SDK maps this to apiSecret → Authorization: Bearer. Never ship to browsers.
# Leave unset only for a local single-mode InboxLink server.
# INBOXLINK_API_SECRET=

# Your host callback after Connect (receives ?public_token=…).
# Use a URL you control — not example.com and not the Google OAuth redirect.
REDIRECT_URI=http://127.0.0.1:9999/done
